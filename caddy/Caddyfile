{
	# Disable HTTP/2 cleartext (h2c) — Node.js nghttp2 triggers
	# NGHTTP2_INTERNAL_ERROR when multiplexed SSE streams reset.
	# LAN-only proxy; h2c provides no benefit here.
	servers {
		protocols h1
	}
}

:11434 {
	@allowed {
		remote_ip 127.0.0.1 10.20.0.1 10.20.0.200 10.20.0.210 10.20.0.222 10.20.0.223 10.20.0.224 10.22.0.0/24 10.40.0.0/24 10.42.0.0/16
	}

	# RETIRED 2026-07-30 — /lmstudio-api/* and /cache-metrics*.
	#
	# Both routed to LM Studio, which no longer serves anything on this host:
	# oMLX took the LLMs at the 2026-07-17 cutover and the embeddings with
	# c6f6ba74 (erlore-embed -> Qwen3-Embedding-0.6B). A live check on
	# 2026-07-30 found LM Studio holding NO loaded models, idling at 1.3 GB.
	#
	#   /lmstudio-api/*  -> LM Studio :1234 native admin API. Its only live
	#     caller was inference-state-watcher, which polled it 84 times per 11
	#     real completions and got back "qwen-tier not-loaded" every time —
	#     true of LM Studio's unloaded copy, misleading about the host. That
	#     watcher moved to oMLX-only in droidkluster/Kluster#264, which is the
	#     prerequisite this change waited on.
	#   /cache-metrics*  -> prompt-cache exporter :11436, which tails LM
	#     Studio's server log. It already returned nothing, and cluster
	#     Prometheus had already dropped it (documented 502 in
	#     servicemonitor-ig88-param-proxy.yaml); only /proxy-metrics is
	#     carried forward.
	#
	# Rollback: the launchd plists are retained in launchd/ — re-add the
	# labels to apply-system.sh and restore these blocks.

	# /proxy-metrics → param-proxy in-process family metrics (127.0.0.1:11435).
	# No strip_prefix: the param-proxy intercepts the literal /proxy-metrics
	# path in-process (like /healthz), so inference paths stay untouched.
	# MUST precede @allowed, which matches all paths for allowed IPs.
	@allowed_proxy_metrics {
		remote_ip 127.0.0.1 10.20.0.1 10.20.0.200 10.20.0.210 10.20.0.222 10.20.0.223 10.20.0.224 10.22.0.0/24 10.40.0.0/24 10.42.0.0/16
		path /proxy-metrics*
	}
	handle @allowed_proxy_metrics {
		reverse_proxy 127.0.0.1:11435 {
			flush_interval -1
		}
	}

	handle @allowed {
		# Route through the Qwen param proxy → oMLX.
		# The proxy supplies Qwen3 sampling defaults for params the caller
		# OMITS; every explicit value is forwarded unchanged (see #8).
		# Architecture: Caddy :11434 → qwen-param-proxy :11435 → oMLX :8000
		reverse_proxy 127.0.0.1:11435 {
			flush_interval -1
		}
	}

	handle {
		respond "forbidden" 403
	}

	log {
		output file /Users/copilot/ig88-host/logs/caddy-access.log
		format console
	}
}

:8880 {
	# TTS endpoint (mlx-audio: Kokoro / Qwen3-TTS) for TC-14. Same trust
	# contract as :11434. Long flush interval irrelevant: responses are
	# whole WAV bodies (request response_format=wav; mp3 needs ffmpeg
	# which is intentionally not installed).
	@allowed {
		remote_ip 127.0.0.1 10.20.0.1 10.20.0.200 10.20.0.210 10.20.0.222 10.20.0.223 10.20.0.224 10.22.0.0/24 10.40.0.0/24 10.20.0.230 10.20.0.231 172.28.45.4 172.28.45.5 172.28.45.6
	}
	handle @allowed {
		reverse_proxy 127.0.0.1:18880 {
			flush_interval -1
		}
	}
	handle {
		respond "forbidden" 403
	}
	log {
		output file /Users/copilot/ig88-host/logs/caddy-access.log
		format console
	}
}
